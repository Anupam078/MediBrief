# MediBrief AI - Environment Variable Template (.env.example)

# -----------------------------------------------------------------------------
# 1. FRONTEND (React)
# Location: frontend/.env
# -----------------------------------------------------------------------------

# Base URL for the Spring Boot Backend API
VITE_API_BASE_URL=https://medibrief-api.render.com

# -----------------------------------------------------------------------------
# 2. BACKEND (Spring Boot)
# Location: backend/src/main/resources/application.properties
# -----------------------------------------------------------------------------

# URL of the AI Service (FastAPI) provided via ngrok/Cloudflare tunnel
AI_SERVICE_URL=https://abc12345.ngrok-free.app

# Timeout configuration for AI processing (milliseconds)
AI_SERVICE_CONNECT_TIMEOUT=5000
AI_SERVICE_READ_TIMEOUT=30000

# Cache configuration (seconds)
CACHE_TTL_SECONDS=3600

# Input validation constraints
INPUT_MAX_LENGTH=5000
INPUT_MIN_LENGTH=50

# -----------------------------------------------------------------------------
# 3. AI SERVICE (FastAPI)
# Location: ai-service/.env
# -----------------------------------------------------------------------------

# Base URL for local Ollama instance
OLLAMA_URL=http://localhost:11434

# LLM Model names pulled via 'ollama pull'
OLLAMA_MODEL_PRIMARY=mistral
OLLAMA_MODEL_FALLBACK=phi3

# SciSpaCy model name (must be installed via pip)
SPACY_MODEL=en_core_sci_md

# Maximum text length to process (should match Backend)
MAX_INPUT_LENGTH=5000

# Logging level (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# 4. TUNNELING (ngrok)
# Required for connecting Render Backend to Local AI Service
# -----------------------------------------------------------------------------

# Your ngrok auth token (get from dashboard.ngrok.com)
NGROK_AUTHTOKEN=your_ngrok_token_here
